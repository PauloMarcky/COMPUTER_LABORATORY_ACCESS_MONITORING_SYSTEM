generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  INSTRUCTOR
  CUSTODIAN
  STUDENT
}

model User {
  id           Int      @id @default(autoincrement()) @map("user_id")
  schoolId     String   @unique @map("school_id")
  password     String
  tokenVersion Int      @default(0) @map("token_version")
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  studentProfile        StudentProfile?
  instructorProfile     InstructorProfile?
  handledPcIssueReports PcIssueReport[]    @relation("CustodianHandledReports")
  custodianProfile      CustodianProfile?

  @@map("users")
}

model StudentProfile {
  id        Int      @id @default(autoincrement()) @map("student_profile_id")
  studentId Int      @unique @map("student_id") // Foreign key to User.id
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  course    String?
  yearLevel Int?     @map("year_level")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user             User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attendanceLogs   AttendanceLog[]
  classEnrollments ClassEnrollment[]
  pcOccupancies    PcOccupancy[]
  pcIssueReports   PcIssueReport[]

  @@map("student_profiles")
}

model InstructorProfile {
  id           Int      @id @default(autoincrement()) @map("instructor_profile_id")
  instructorId Int      @unique @map("instructor_id")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  department   String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user               User                @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  schedules          Schedule[]
  instructorSubjects InstructorSubject[] // ← MOVED UP

  @@map("instructor_profiles")
}

model LabRoom {
  id          Int      @id @default(autoincrement()) @map("lab_room_id")
  roomName    String   @map("room_name")
  capacity    Int?
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  schedules Schedule[]

  pcs       Pc[]

  @@map("lab_rooms")
}

model Pc {
  id        Int      @id @default(autoincrement()) @map("pc_id")
  labRoomId Int      @map("lab_room_id")
  pcNumber  String   @map("pc_number") @db.VarChar(20)
  status    String   @default("AVAILABLE") @db.VarChar(20)
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  labRoom LabRoom @relation(fields: [labRoomId], references: [id], onDelete: Cascade)

  @@unique([labRoomId, pcNumber])
  @@map("pcs")
}

model Schedule {
  scheduleId   Int      @id @default(autoincrement()) @map("schedule_id")
  termId       Int?     @map("term_id")
  instructorId Int      @map("instructor_id")
  labRoomId    Int      @map("lab_room_id")
  subjectCode  String   @map("subject_code") @db.VarChar(191)
  section      String   @default("A") @db.VarChar(10)
  yearLevel    Int      @default(1) @map("year_level")
  dayOfWeek    String   @map("day_of_week") @db.VarChar(191)
  startTime    DateTime @map("start_time") @db.DateTime(3)
  endTime      DateTime @map("end_time") @db.DateTime(3)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  instructor       InstructorProfile @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  labRoom          LabRoom           @relation(fields: [labRoomId], references: [id], onDelete: Cascade)
  term             Term?             @relation(fields: [termId], references: [id], onDelete: SetNull)
  classEnrollments ClassEnrollment[]
  activeSessions   ActiveSession[]

  @@map("schedules")
}

model ClassEnrollment {
  id               Int      @id @default(autoincrement()) @map("class_enrollment_id")
  studentProfileId Int      @map("student_profile_id")
  scheduleId       Int      @map("schedule_id")
  enrolledAt       DateTime @default(now()) @map("enrolled_at")

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  schedule       Schedule       @relation(fields: [scheduleId], references: [scheduleId], onDelete: Cascade)

  @@unique([studentProfileId, scheduleId])
  @@map("class_enrollment")
}

model ActiveSession {
  id            Int       @id @default(autoincrement()) @map("active_session_id")
  scheduleId    Int       @map("schedule_id")
  sessionDate   DateTime  @default(now()) @map("session_date")
  startTime     DateTime  @default(now()) @map("start_time")
  endTime       DateTime? @map("end_time")
  status        String    @default("ACTIVE")
  reportStatus  String    @default("PENDING") @map("report_status") @db.VarChar(20)
  reportRemarks String?   @map("report_remarks") @db.Text

  schedule       Schedule        @relation(fields: [scheduleId], references: [scheduleId], onDelete: Cascade)
  attendanceLogs AttendanceLog[]
  pcOccupancies  PcOccupancy[]
  pcIssueReports PcIssueReport[]

  @@map("active_session")
}

model AttendanceLog {
  id               Int       @id @default(autoincrement()) @map("attendance_log_id")
  studentProfileId Int       @map("student_profile_id")
  activeSessionId  Int       @map("active_session_id")
  timeIn           DateTime  @default(now()) @map("time_in")
  timeOut          DateTime? @map("time_out")

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  activeSession  ActiveSession  @relation(fields: [activeSessionId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, activeSessionId])
  @@map("attendance_log")
}

model PcOccupancy {
  id               Int       @id @default(autoincrement()) @map("pc_occupancy_id")
  activeSessionId  Int       @map("active_session_id")
  studentProfileId Int       @map("student_profile_id")
  pcNumber         String    @map("pc_number")
  timeClaimed      DateTime  @default(now()) @map("time_claimed")
  timeReleased     DateTime? @map("time_released")

  activeSession  ActiveSession  @relation(fields: [activeSessionId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@map("pc_occupancy")
}

model PcIssueReport {
  id               Int      @id @default(autoincrement()) @map("pc_issue_report_id")
  activeSessionId  Int      @map("active_session_id")
  studentProfileId Int      @map("student_profile_id")
  handledById      Int?     @map("handled_by_id")
  pcNumber         String   @map("pc_number")
  category         String   @default("Other") @db.VarChar(50)
  issueDescription String   @map("issue_description") @db.Text
  status           String   @default("PENDING")
  staffNotes       String?  @map("staff_notes") @db.Text
  reportedAt       DateTime @default(now()) @map("reported_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  activeSession  ActiveSession  @relation(fields: [activeSessionId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  handledBy      User?          @relation("CustodianHandledReports", fields: [handledById], references: [id], onDelete: SetNull)

  images         PcIssueReportImage[]

  @@map("pc_issue_report")
}

model Term {
  id           Int        @id @default(autoincrement()) @map("term_id")
  academicYear String     @map("academic_year") @db.VarChar(20)
  semester     String     @db.VarChar(20)
  startDate    DateTime   @map("start_date") @db.Date
  endDate      DateTime   @map("end_date") @db.Date
  isActive     Boolean    @default(false) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at")
  schedules    Schedule[]

  @@unique([academicYear, semester])
  @@map("terms")
}

model CustodianProfile {
  id          Int      @id @default(autoincrement()) @map("custodian_profile_id")
  custodianId Int      @unique @map("custodian_id")
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [custodianId], references: [id], onDelete: Cascade)

  @@map("custodian_profiles")
}

model Subject {
  id        Int      @id @default(autoincrement()) @map("subject_id")
  code      String   @unique @db.VarChar(20)
  title     String   @db.VarChar(191)
  yearLevel Int?     @map("year_level")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  instructorSubjects InstructorSubject[]

  @@map("subjects")
}

model PcIssueReportImage {
  id              Int      @id @default(autoincrement()) @map("pc_issue_report_image_id")
  pcIssueReportId Int      @map("pc_issue_report_id")
  imageUrl        String   @map("image_url") @db.VarChar(500)
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")

  pcIssueReport PcIssueReport @relation(fields: [pcIssueReportId], references: [id], onDelete: Cascade)

  @@index([pcIssueReportId])
  @@map("pc_issue_report_images")
}

model InstructorSubject {
  id           Int      @id @default(autoincrement()) @map("instructor_subject_id")
  instructorId Int      @map("instructor_id")
  subjectId    Int      @map("subject_id")
  createdAt    DateTime @default(now()) @map("created_at")

  instructor InstructorProfile @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  subject    Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([instructorId, subjectId])
  @@map("instructor_subjects")
}
